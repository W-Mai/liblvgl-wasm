# Inspect the selected headers with the same compiler used by API generation.
find_package(Python3 3.9 REQUIRED COMPONENTS Interpreter)
get_filename_component(LVW_COMPILER_DIRECTORY "${CMAKE_C_COMPILER}" DIRECTORY)
get_filename_component(LVW_SDK "${LVW_COMPILER_DIRECTORY}/.." REALPATH)
set(LVW_SOURCE_REPORT "${CMAKE_BINARY_DIR}/lvgl-source.json")
file(REMOVE "${LVW_SOURCE_REPORT}")
execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${PROJECT_SOURCE_DIR}/generator/lvgl.py"
    --source "${lvgl_SOURCE_DIR}" --config "${LVW_CONF_PATH}" --sdk "${LVW_SDK}"
    OUTPUT_FILE "${LVW_SOURCE_REPORT}" ERROR_VARIABLE LVW_INSPECT_ERROR
    RESULT_VARIABLE LVW_INSPECT_RESULT)
if(NOT LVW_INSPECT_RESULT EQUAL 0)
    file(REMOVE "${LVW_SOURCE_REPORT}")
    message(FATAL_ERROR "Cannot inspect configured LVGL: ${LVW_INSPECT_ERROR}")
endif()
file(READ "${LVW_SOURCE_REPORT}" LVW_SOURCE_JSON)
string(JSON LVW_VERSION_MAJOR GET "${LVW_SOURCE_JSON}" version major)
if(NOT LVW_VERSION_MAJOR EQUAL 9)
    message(FATAL_ERROR "Native adapters require an independently verified LVGL v9 source")
endif()
string(JSON LVW_HEADER_LAYOUT GET "${LVW_SOURCE_JSON}" layout)
get_filename_component(LVW_CONF_DIR "${LVW_CONF_PATH}" DIRECTORY)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${LVW_CONF_PATH}")

function(lvw_config_flag name)
    string(JSON value ERROR_VARIABLE missing GET "${LVW_SOURCE_JSON}" configuration "${name}" value)
    if(missing)
        string(JSON present ERROR_VARIABLE absent GET "${LVW_SOURCE_JSON}" configuration "${name}")
        if(NOT absent)
            message(FATAL_ERROR "LVGL configuration is not an integer: ${name}")
        endif()
        set(value 0)
    endif()
    set("${name}" "${value}" PARENT_SCOPE)
endfunction()

foreach(flag LV_USE_THORVG LV_USE_THORVG_INTERNAL LV_USE_FREETYPE LV_USE_GIF LV_USE_LODEPNG
             LV_USE_SVG LV_USE_LOTTIE LV_USE_OBSERVER)
    lvw_config_flag(${flag})
endforeach()

set(LVW_BRIDGE_FEATURES "timer;animation;observer;decoder" CACHE STRING
    "Managed host callbacks to build; an empty list builds the base bridge")
set(LVW_BRIDGE_DEFINITIONS)
foreach(feature IN ITEMS timer animation observer decoder)
    string(TOUPPER "${feature}" upper)
    if(feature IN_LIST LVW_BRIDGE_FEATURES)
        set("LVW_MANAGED_${upper}" ON)
        list(APPEND LVW_BRIDGE_DEFINITIONS "LVW_MANAGED_${upper}=1")
    else()
        set("LVW_MANAGED_${upper}" OFF)
        list(APPEND LVW_BRIDGE_DEFINITIONS "LVW_MANAGED_${upper}=0")
    endif()
endforeach()
foreach(feature IN LISTS LVW_BRIDGE_FEATURES)
    if(NOT feature MATCHES "^(timer|animation|observer|decoder)$")
        message(FATAL_ERROR "Unknown managed bridge feature: ${feature}")
    endif()
endforeach()
foreach(feature IN ITEMS timer animation)
    string(TOUPPER "${feature}" upper)
    string(JSON available GET "${LVW_SOURCE_JSON}" declaration_probes "${feature}_external_data" declared)
    set("LVW_${upper}_EXTERNAL_DATA" "${available}")
    if(available)
        list(APPEND LVW_BRIDGE_DEFINITIONS "LVW_${upper}_EXTERNAL_DATA=1")
    else()
        list(APPEND LVW_BRIDGE_DEFINITIONS "LVW_${upper}_EXTERNAL_DATA=0")
    endif()
endforeach()
if(LVW_MANAGED_OBSERVER AND NOT LV_USE_OBSERVER)
    message(FATAL_ERROR "Requested managed observer requires LV_USE_OBSERVER")
endif()

function(lvw_configure_target)
    file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/lvgl-archive.txt" CONTENT "$<TARGET_FILE:lvgl>\n")
    target_include_directories(lvgl PUBLIC "$<BUILD_INTERFACE:${LVW_CONF_DIR}>")
endfunction()
string(JSON LVW_INPUT_TIMESTAMP GET "${LVW_SOURCE_JSON}" declaration_probes input_timestamp declared)
if(LVW_INPUT_TIMESTAMP)
    list(APPEND LVW_BRIDGE_DEFINITIONS LVW_INPUT_TIMESTAMP=1)
else()
    list(APPEND LVW_BRIDGE_DEFINITIONS LVW_INPUT_TIMESTAMP=0)
endif()

# Source consumers use the same include name as installed NDK consumers.
set(LVW_BRIDGE_INCLUDE_DIR "${lvgl_SOURCE_DIR}/src")
if(LVW_HEADER_LAYOUT STREQUAL "root")
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/include/lvgl")
    file(WRITE "${CMAKE_BINARY_DIR}/include/lvgl/lvgl.h" "#include \"${lvgl_SOURCE_DIR}/lvgl.h\"\n")
    list(APPEND LVW_BRIDGE_INCLUDE_DIR "${CMAKE_BINARY_DIR}/include")
endif()
