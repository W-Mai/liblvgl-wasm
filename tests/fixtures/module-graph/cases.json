  { "name": "application provider", "modules": [{ "id": "a", "role": "lib", "requires": [{ "provider": "app" }] }, { "id": "app", "role": "app", "requires": [] }], "hostProviders": [], "error": "App cannot be a provider" },
  { "name": "application depends on application", "modules": [{ "id": "a", "role": "app", "requires": [{ "provider": "app" }] }, { "id": "app", "role": "app", "requires": [] }], "hostProviders": [], "error": "App cannot be a provider" },
