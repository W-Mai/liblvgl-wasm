  { "name": "duplicate modules", "modules": [{ "id": "a", "role": "lib", "requires": [] }, { "id": "a", "role": "lib", "requires": [] }], "hostProviders": [], "error": "Duplicate provider ID" },
  { "name": "duplicate host", "modules": [], "hostProviders": ["a", "a"], "error": "Duplicate provider ID" },
